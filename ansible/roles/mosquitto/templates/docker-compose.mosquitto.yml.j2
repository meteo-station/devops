version: "3.8"

name: {{compose_project_name}}

services:
  mosquitto:
    image: eclipse-mosquitto:2
    restart: unless-stopped
    ports:
      - "1883:1883"
    volumes:
      - ./mosquitto:/mosquitto
    networks:
      - "{{ compose_project_name }}-internal"

networks:
  "{{ compose_project_name }}-internal":
    external: true
