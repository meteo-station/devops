version: "3.13"

name: {{compose_project_name}}

services:
  pgsql:
    image: wodby/postgres
    networks:
      - "{{ compose_project_name }}-internal"
      - monitoring-internal
    restart:
      unless-stopped
    ports:
      - "127.0.0.1:5434:5432"
    logging:
      driver: json-file
      options:
        max-size: 100m
        max-file: "2"
    environment:
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_DB: ${POSTGRES_DB}
    volumes:
      - postgres:/var/lib/postgresql/data
      - ./pgsql/init.sql.j2:/docker-entrypoint-initdb.d/init.sql.j2


volumes:
  postgres:

networks:
  "{{ compose_project_name }}-internal":
    external: true
  monitoring-internal:
    external: true
