# alpine + postgresql18-client/kubectl/openssh-client, см. images/backup-tools.
# Раньше эти пакеты ставились через apk на каждом запуске, из-за чего бэкап
# зависел от доступности зеркала Alpine.
image:
  repository: ghcr.io/bonavi/backup-tools
  tag: "latest"
  # latest мутабелен, поэтому IfNotPresent оставил бы ноду на старом слое
  # после пересборки образа.
  pullPolicy: Always

deployment:
  enabled: false
service:
  enabled: false

envs:
  PG_DATABASES: "superset"
  PG_USER: adrush
  PG_PORT: "5432"
  BACKUP_DIR: /backup

secretEnv:
  PGPASSWORD: "{{ .Values.backups.codex_monitoring.pg_password }}"
  SSH_HOST: "{{ .Values.backups.codex_monitoring.ssh_host }}"
  SSH_USER: "{{ .Values.backups.codex_monitoring.ssh_user }}"
  SSH_PORT: "{{ .Values.backups.codex_monitoring.ssh_port }}"

# Приватный SSH-ключ для туннеля к удалённому postgres — кладётся из SOPS.
# Имя секрета получится backup-codex_monitoring-ssh_key (release + ключ), совпадает с volumes.secretName ниже.
extraSecrets:
  ssh-key:
    stringData:
      id_ed25519: |
{{ .Values.backups.codex_monitoring.ssh_key | indent 8 }}

cronjobs:
  dump:
    enabled: true
    schedule: "0 * * * *"
    timeZone: "Europe/Moscow"
    concurrencyPolicy: Forbid
    activeDeadlineSeconds: 1800
    ttlSecondsAfterFinished: 86400
    restartPolicy: OnFailure
    command: ["/bin/sh", "-c"]
    args:
      - |
        set -euo pipefail

        log() { echo "[$(date -u +%H:%M:%S)] $*"; }

        mkdir -p "$BACKUP_DIR"
        TS=$(date -u +%Y-%m-%dT%H-%M-%SZ)
        log "старт: базы [$PG_DATABASES], localhost:$PG_PORT на $SSH_HOST"

        install -m 0400 /ssh/id_ed25519 /tmp/id_ed25519
        log "поднимаю ssh-туннель"
        ssh -i /tmp/id_ed25519 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
          -p "$SSH_PORT" -N -L "5432:127.0.0.1:$PG_PORT" "$SSH_USER@$SSH_HOST" &
        PF_PID=$!
        trap 'kill $PF_PID 2>/dev/null || true' EXIT

        # Проверка через pg_isready, а не через (echo > /dev/tcp/...): последнее
        # умеет только bash, а здесь busybox ash — там это всегда ошибка, то
        # есть цикл впустую отсиживал 30 секунд и шёл дальше вслепую.
        READY=""
        for i in $(seq 1 30); do
          pg_isready -h 127.0.0.1 -p 5432 -q && { READY=1; break; }
          sleep 1
        done
        if [ -z "$READY" ]; then
          log "ОШИБКА: ssh-туннель не поднялся за 30с"
          exit 1
        fi
        log "туннель готов за ${i}с"

        # $SECONDS в busybox ash нет, поэтому считаем по date +%s
        STARTED=$(date +%s)
        for DB in $PG_DATABASES; do
          OUT="$BACKUP_DIR/${DB}-${TS}.sql.gz"
          log "дамп $DB -> $OUT"
          T0=$(date +%s)
          pg_dump -h 127.0.0.1 -p 5432 -U "$PG_USER" -d "$DB" \
            --no-owner --no-privileges --clean --if-exists \
            | gzip -9 > "$OUT"
          log "готово $DB: $(du -h "$OUT" | cut -f1) за $(($(date +%s) - T0))с"
        done

        log "все дампы записаны в $BACKUP_DIR за $(($(date +%s) - STARTED))с, свободно: $(df -h "$BACKUP_DIR" | awk 'NR==2 {print $4}')"
    volumeMounts:
      - { name: ssh-key, mountPath: /ssh, readOnly: true }
      - { name: backup,  mountPath: /backup }
    volumes:
      - name: ssh-key
        secret:
          secretName: backup-codex-monitoring-ssh-key   # key: id_ed25519
          defaultMode: 0400
      - name: backup
        hostPath:
          path: /mnt/backup/codex-monitoring
          type: DirectoryOrCreate
