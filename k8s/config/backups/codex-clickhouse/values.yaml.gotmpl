# alpine + curl/openssh-client, см. images/backup-tools. Раньше базой был
# clickhouse/clickhouse-server (745 МБ) ради одного клиента, а openssh ставился
# через apk на каждом запуске — бэкап зависел от доступности зеркала Alpine.
image:
  repository: ghcr.io/bonavi/backup-tools
  tag: "latest"
  # latest мутабелен, поэтому IfNotPresent оставил бы ноду на старом слое
  # после пересборки образа.
  pullPolicy: Always

deployment:
  enabled: false
service:
  enabled: false

envs:
  CH_DATABASES: "analytics"
  CH_TABLES: "analytic_aggr_partner_reconciliation"
  CH_USER: adrush
  # HTTP-интерфейс ClickHouse, а не нативный протокол на 9000
  CH_PORT: "8123"
  BACKUP_DIR: /backup

secretEnv:
  CHPASSWORD: "{{ .Values.backups.codex_clickhouse.ch_password }}"
  SSH_HOST: "{{ .Values.backups.codex_clickhouse.ssh_host }}"
  SSH_USER: "{{ .Values.backups.codex_clickhouse.ssh_user }}"
  SSH_PORT: "{{ .Values.backups.codex_clickhouse.ssh_port }}"

# Приватный SSH-ключ для туннеля к удалённому ClickHouse — кладётся из SOPS.
# Имя секрета получится backup-clickhouse-ssh-key (release + ключ), совпадает с volumes.secretName ниже.
extraSecrets:
  ssh-key:
    stringData:
      id_ed25519: |
{{ .Values.backups.codex_clickhouse.ssh_key | indent 8 }}

cronjobs:
  dump:
    enabled: true
    schedule: "0 * * * *"
    timeZone: "Europe/Moscow"
    concurrencyPolicy: Forbid
    activeDeadlineSeconds: 1800
    # 15 минут: упавшая джоба живёт ровно столько, чтобы KubeJobFailed успел
    # улететь, а потом удаляется и алерт сам резолвится. Детект тихого простоя
    # держит CronJobNoSuccessfulRun по kube_cronjob_status_last_successful_time,
    # он от этого TTL не зависит.
    ttlSecondsAfterFinished: 900
    restartPolicy: OnFailure
    command: ["/bin/sh", "-c"]
    args:
      - |
        set -euo pipefail

        log() { echo "[$(date -u +%H:%M:%S)] $*"; }

        mkdir -p "$BACKUP_DIR"
        TS=$(date -u +%Y-%m-%dT%H-%M-%SZ)
        log "старт: базы [$CH_DATABASES], таблицы [${CH_TABLES:-все}], 192.168.50.1:$CH_PORT через $SSH_HOST"

        install -m 0400 /ssh/id_ed25519 /tmp/id_ed25519
        log "поднимаю ssh-туннель"
        ssh -i /tmp/id_ed25519 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
          -p "$SSH_PORT" -N -L "8123:192.168.50.1:$CH_PORT" "$SSH_USER@$SSH_HOST" &
        PF_PID=$!
        trap 'kill $PF_PID 2>/dev/null || true' EXIT

        # Проверка через /ping, а не через (echo > /dev/tcp/...): последнее
        # умеет только bash, а здесь busybox ash — там это всегда ошибка, то
        # есть цикл впустую отсиживал 30 секунд и шёл дальше вслепую.
        READY=""
        for i in $(seq 1 30); do
          curl -sf -m2 "http://127.0.0.1:8123/ping" >/dev/null 2>&1 && { READY=1; break; }
          sleep 1
        done
        if [ -z "$READY" ]; then
          log "ОШИБКА: ssh-туннель не поднялся за 30с (проверьте, слушает ли ClickHouse HTTP на $CH_PORT)"
          exit 1
        fi
        log "туннель готов за ${i}с"

        # Запросы идут по HTTP, а не родным клиентом: у ClickHouse клиент и
        # сервер — один монолитный бинарь на ~490 МБ, из-за которого образ
        # бэкапа весил 745 МБ вместо 20. HTTP отдаёт тот же FORMAT Native,
        # содержимое дампа побайтово совпадает.
        #
        # Креды уходят заголовками, а не в URL и не аргументами командной
        # строки: так пароль не виден в списке процессов.
        #
        # --fail-with-body обязателен: без него curl молча вернёт 0 и текст
        # ошибки ClickHouse уедет в файл дампа вместо данных.
        CH() {
          curl -sS --fail-with-body \
            -H "X-ClickHouse-User: $CH_USER" \
            -H "X-ClickHouse-Key: $CHPASSWORD" \
            --data-binary "$1" "http://127.0.0.1:8123/"
        }

        log "проверяю доступность ClickHouse: $(CH 'SELECT version()')"

        # $SECONDS в busybox ash нет, поэтому считаем по date +%s
        STARTED=$(date +%s)
        for DB in $CH_DATABASES; do
          WORKDIR=$(mktemp -d)
          T_DB=$(date +%s)
          if [ -n "$CH_TABLES" ]; then
            TABLES="$CH_TABLES"
          else
            TABLES=$(CH "SHOW TABLES FROM $DB")
          fi
          for TABLE in $TABLES; do
            log "дамп $DB.$TABLE"
            T0=$(date +%s)
            CH "SHOW CREATE TABLE $DB.\`$TABLE\`" > "$WORKDIR/${TABLE}.schema.sql"
            CH "SELECT * FROM $DB.\`$TABLE\` FORMAT Native" > "$WORKDIR/${TABLE}.native"
            log "  строк: $(CH "SELECT count() FROM $DB.\`$TABLE\`"), данные: $(du -h "$WORKDIR/${TABLE}.native" | cut -f1) за $(($(date +%s) - T0))с"
          done
          OUT="$BACKUP_DIR/${DB}-${TS}.tar.gz"
          tar -C "$WORKDIR" -czf "$OUT" .
          rm -rf "$WORKDIR"
          log "готово $DB -> $OUT: $(du -h "$OUT" | cut -f1) за $(($(date +%s) - T_DB))с"
        done

        log "все дампы записаны в $BACKUP_DIR за $(($(date +%s) - STARTED))с, свободно: $(df -h "$BACKUP_DIR" | awk 'NR==2 {print $4}')"
    volumeMounts:
      - { name: ssh-key, mountPath: /ssh, readOnly: true }
      - { name: backup,  mountPath: /backup }
    volumes:
      - name: ssh-key
        secret:
          secretName: backup-codex-clickhouse-ssh-key   # key: id_ed25519
          defaultMode: 0400
      - name: backup
        hostPath:
          path: /mnt/backup/codex-clickhouse
          type: DirectoryOrCreate
