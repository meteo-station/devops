# alpine + postgresql18-client/kubectl/openssh-client, см. images/backup-tools.
# Раньше эти пакеты ставились через apk на каждом запуске, из-за чего бэкап
# зависел от доступности зеркала Alpine.
image:
  repository: ghcr.io/bonavi/backup-tools
  tag: "latest"
  # latest мутабелен, поэтому IfNotPresent оставил бы ноду на старом слое
  # после пересборки образа.
  pullPolicy: Always

deployment:
  enabled: false
service:
  enabled: false

envs:
  REMOTE_NAMESPACE: postgres-prod
  REMOTE_SERVICE: postgres-postgresql
  REMOTE_PORT: "5432"
  PG_DATABASES: "coin grafana"
  PG_USER: postgres
  BACKUP_DIR: /backup

secretEnv:
  PGPASSWORD: "{{ .Values.backups.coin.pg_password }}"

# Kubeconfig для удалённого coin-кластера — кладётся из SOPS как multiline-строка.
# Имя получится backup-coin-kubeconfig (release + ключ), совпадает с volumes.secretName ниже.
extraSecrets:
  kubeconfig:
    stringData:
      config: |
{{ .Values.backups.coin.kubeconfig | indent 8 }}

cronjobs:
  dump:
    enabled: true
    schedule: "0 * * * *"
    timeZone: "Europe/Moscow"
    concurrencyPolicy: Forbid
    activeDeadlineSeconds: 1800
    ttlSecondsAfterFinished: 86400
    restartPolicy: OnFailure
    command: ["/bin/sh", "-c"]
    args:
      - |
        set -euo pipefail

        log() { echo "[$(date -u +%H:%M:%S)] $*"; }

        mkdir -p "$BACKUP_DIR"
        TS=$(date -u +%Y-%m-%dT%H-%M-%SZ)
        log "старт: базы [$PG_DATABASES], кластер $REMOTE_NAMESPACE/$REMOTE_SERVICE"

        export KUBECONFIG=/kube/config
        log "поднимаю port-forward на $REMOTE_SERVICE:$REMOTE_PORT"
        kubectl port-forward -n "$REMOTE_NAMESPACE" "svc/$REMOTE_SERVICE" "5432:$REMOTE_PORT" >/tmp/pf.log 2>&1 &
        PF_PID=$!
        trap 'kill $PF_PID 2>/dev/null || true' EXIT

        # Проверка через pg_isready, а не через (echo > /dev/tcp/...): последнее
        # умеет только bash, а здесь busybox ash — там это всегда ошибка, то
        # есть цикл впустую отсиживал 30 секунд и шёл дальше вслепую.
        READY=""
        for i in $(seq 1 30); do
          pg_isready -h 127.0.0.1 -p 5432 -q && { READY=1; break; }
          sleep 1
        done
        if [ -z "$READY" ]; then
          log "ОШИБКА: port-forward не поднялся за 30с, вывод kubectl:"
          cat /tmp/pf.log
          exit 1
        fi
        log "туннель готов за ${i}с"

        # $SECONDS в busybox ash нет, поэтому считаем по date +%s
        STARTED=$(date +%s)
        for DB in $PG_DATABASES; do
          OUT="$BACKUP_DIR/${DB}-${TS}.sql.gz"
          log "дамп $DB -> $OUT"
          T0=$(date +%s)
          pg_dump -h 127.0.0.1 -p 5432 -U "$PG_USER" -d "$DB" \
            --no-owner --no-privileges --clean --if-exists \
            | gzip -9 > "$OUT"
          log "готово $DB: $(du -h "$OUT" | cut -f1) за $(($(date +%s) - T0))с"
        done

        log "все дампы записаны в $BACKUP_DIR за $(($(date +%s) - STARTED))с, свободно: $(df -h "$BACKUP_DIR" | awk 'NR==2 {print $4}')"
    volumeMounts:
      - { name: kubeconfig, mountPath: /kube, readOnly: true }
      - { name: backup,     mountPath: /backup }
    volumes:
      - name: kubeconfig
        secret:
          secretName: backup-coin-kubeconfig   # key: config
          defaultMode: 0400
      - name: backup
        hostPath:
          path: /mnt/backup/coin
          type: DirectoryOrCreate
