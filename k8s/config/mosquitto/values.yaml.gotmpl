image:
  repository: eclipse-mosquitto
  tag: "2"

replicaCount: 1

hostNetwork: true

# fsGroup=1883 (gid mosquitto) → ConfigMap-файлы получат группу mosquitto.
# С defaultMode 0640 их сможет прочитать процесс mosquitto по group-биту,
# не выдавая права наружу.
podSecurityContext:
  fsGroup: 1883

command: ["mosquitto"]
args: ["-c", "/mosquitto/config/mosquitto.conf"]

service:
  enabled: true
  type: ClusterIP
  ports:
    - name: mqtt
      port: 1883
      targetPort: 1883

secretEnv:
  # Одна строка "user:password" на пользователя (сырой пароль) — сама хэширует
  # initContainer gen-passwd ниже. Добавить/убрать пользователя = только правка
  # .Values.mosquitto.users в secrets-prod.yaml, конфиг трогать не нужно.
  MOSQUITTO_USERS: |
    {{- range $key, $u := .Values.mosquitto.users }}
    {{ $u.user }}:{{ $u.password }}
    {{- end }}

extraConfigMaps:
  config:
    data:
      mosquitto.conf: |
        listener 1883
        protocol mqtt

        allow_anonymous false
        password_file /mosquitto/config/passwd
        acl_file /mosquitto/config/acl

        persistence true
        persistence_location /mosquitto/data
        autosave_interval 1800

        max_connections 1024
        max_inflight_messages 20
        max_queued_messages 1000

        log_dest stdout
        log_type error
        log_type warning
        log_type notice
        log_type information

        allow_zero_length_clientid false
      acl: |
        user esp-meteo-station
        topic write esp-meteo-station/+/data

        user go-exporter
        topic read esp-meteo-station/+/data

        user admin
        topic readwrite #

# passwd-файл больше не хранится в git даже в виде хэша — его на каждом старте
# пода генерирует mosquitto_passwd из MOSQUITTO_USERS (секрет выше) в emptyDir,
# который потом монтируется в основной контейнер.
initContainers:
  - name: gen-passwd
    image: "eclipse-mosquitto:2"
    command: ["/bin/sh", "-c"]
    args:
      - |
        set -euo pipefail
        touch /generated/passwd
        echo "$MOSQUITTO_USERS" | while IFS=: read -r USER PASS; do
          [ -z "$USER" ] && continue
          mosquitto_passwd -b /generated/passwd "$USER" "$PASS"
        done
        chmod 0700 /generated/passwd
    envFrom:
      - secretRef:
          name: mosquitto
    volumeMounts:
      - name: generated
        mountPath: /generated

volumes:
  - name: config
    configMap:
      name: mosquitto-config
      defaultMode: 0640
  - name: generated
    emptyDir: {}
  - name: data
    hostPath:
      path: /var/lib/mosquitto/data
      type: DirectoryOrCreate

volumeMounts:
  # subPath кладёт реальные файлы (не симлинки): mosquitto 2.x открывает
  # mosquitto.conf/acl с O_NOFOLLOW и отказывается следовать по симлинкам,
  # которые создаёт обычный ConfigMap-маунт (файл -> ..data/файл).
  - name: config
    mountPath: /mosquitto/config/mosquitto.conf
    subPath: mosquitto.conf
  - name: config
    mountPath: /mosquitto/config/acl
    subPath: acl
  - name: generated
    mountPath: /mosquitto/config/passwd
    subPath: passwd
  - name: data
    mountPath: /mosquitto/data
