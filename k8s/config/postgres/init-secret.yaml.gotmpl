resources:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: postgres-init-scripts
      namespace: postgres-{{ .Environment.Name }}
    type: Opaque
    stringData:
      postgres-password: "{{ .Values.pgsql.users.postgres.password }}"
      init.sql: |
        {{- range $name, $val := .Values.pgsql.users }}
        DO $$ BEGIN
          IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{{ $name }}') THEN
            CREATE USER {{ $name }} WITH PASSWORD '{{ $val.password }}';
          END IF;
        END $$;
        SELECT 'CREATE DATABASE {{ $name }} OWNER {{ $name }}'
          WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '{{ $name }}')\gexec
        {{- end }}

  - apiVersion: batch/v1
    kind: Job
    metadata:
      name: postgres-init-job
      namespace: postgres-{{ .Environment.Name }}
      annotations:
        helm.sh/hook: post-install,post-upgrade
        helm.sh/hook-delete-policy: before-hook-creation
    spec:
      template:
        spec:
          restartPolicy: OnFailure
          containers:
            - name: init
              image: postgres:16
              env:
                - name: PGPASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: postgres-init-scripts
                      key: postgres-password
              command:
                - bash
                - -c
                - |
                  psql -h postgres-postgresql.postgres-{{ .Environment.Name }}.svc.cluster.local -U postgres -f /scripts/init.sql
              volumeMounts:
                - name: scripts
                  mountPath: /scripts
          volumes:
            - name: scripts
              secret:
                secretName: postgres-init-scripts
                items:
                  - key: init.sql
                    path: init.sql