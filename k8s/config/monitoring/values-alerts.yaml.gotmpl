# ============================================================
# PrometheusRule — кастомные правила алертинга
# ============================================================

additionalPrometheusRulesMap:
  node-availability:
    groups:
    - name: node-availability
      rules:
      # Алерт срабатывает если node-exporter на сервере недоступен более 2 минут.
      # Метрика up проставляется самим прометеем: 1 = скрейп успешен, 0 = недоступен.
      # Покрывает серверы rumex и ficus (определены в values-prometheus.yaml.gotmpl).
      - alert: NodeDown
        expr: up{job="node-exporter"} == 0
        for: 2m
        labels:
          severity: Critical
        annotations:
          summary: "Node {{ "{{" }} $labels.instance }} is down"
          description: "Node exporter on {{ "{{" }} $labels.instance }} has been unreachable for more than 2 minutes"

  cronjobs:
    groups:
    - name: cronjobs
      rules:

      # CronJob не завершался успешно дольше 25 часов (бэкапы у нас ежечасные —
      # 24 + запас). Ловит ситуацию, когда CronJob тихо не отрабатывает (suspended,
      # нет нод, image pull fail и т.п.).
      - alert: CronJobNoSuccessfulRun
        expr: |
          (time() - max by (namespace, cronjob) (
            kube_job_status_completion_time
            * on(namespace, job_name) group_left(cronjob)
              kube_job_owner{owner_kind="CronJob"}
          )) > 25 * 3600
        for: 10m
        labels:
          severity: Critical
        annotations:
          summary: "CronJob {{ "{{" }} $labels.namespace }}/{{ "{{" }} $labels.cronjob }} has no successful run for > 25h"
          description: "Последний успешный запуск был более суток назад. Проверь расписание, suspend, PodDisruptionBudget и события в namespace."
