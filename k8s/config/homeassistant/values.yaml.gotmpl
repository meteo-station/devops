image:
  repository: ghcr.io/home-assistant/home-assistant
  tag: stable

replicaCount: 1

# hostNetwork нужен для автообнаружения устройств (mDNS/SSDP/HomeKit) —
# они работают по multicast в L2-сети дома, до пода в overlay-сети не долетают.
hostNetwork: true
dnsPolicy: ClusterFirstWithHostNet

# hostNetwork занимает порт 8123 на ноде: при RollingUpdate новый под не может
# стартовать, пока старый держит порт. Recreate сначала гасит старый под.
deployment:
  strategy:
    type: Recreate
    rollingUpdate: null
  # AppArmor-профиль по умолчанию (docker-default) режет обращения к системной
  # шине хоста, смонтированной ниже, — без unconfined HA не достучится до dbus.
  podAnnotations:
    container.apparmor.security.beta.kubernetes.io/homeassistant: unconfined

service:
  enabled: true
  type: ClusterIP
  ports:
    - name: http
      port: 8123
      targetPort: 8123

ingresses:
  - name: main
    enabled: true
    className: nginx
    annotations:
      cert-manager.io/cluster-issuer: selfsigned-home
    hosts:
      - host: homeassistant.home
        paths:
          - path: /
            pathType: Prefix
      # Внешний доступ: coin-1 проксирует сюда через WG, форвардя Host как есть.
      # Серт селфсайн — coin-1 его не проверяет (proxy-ssl-verify off), нужен
      # только чтобы rpi-ingress подобрал server-блок по SNI home.bonavii.com.
      - host: home.bonavii.com
        paths:
          - path: /
            pathType: Prefix
    tls:
      - hosts: [homeassistant.home]
        secretName: homeassistant-home-tls
      - hosts: [home.bonavii.com]
        secretName: home-bonavii-rpi-tls

# HA стартует медленно (первый запуск ставит зависимости интеграций),
# поэтому startupProbe с большим failureThreshold, а liveness — уже после него.
startupProbe:
  enabled: true
  httpGet:
    path: /
    port: http
  failureThreshold: 60
  periodSeconds: 10
  timeoutSeconds: 5

livenessProbe:
  enabled: true
  httpGet:
    path: /
    port: http
  periodSeconds: 30
  timeoutSeconds: 5
  failureThreshold: 3

readinessProbe:
  enabled: true
  httpGet:
    path: /
    port: http
  periodSeconds: 10
  timeoutSeconds: 5
  failureThreshold: 3

resources:
  requests:
    cpu: 200m
    memory: 512Mi
  limits:
    cpu: "2"
    memory: 2Gi

envs:
  TZ: Europe/Moscow

extraConfigMaps:
  config:
    # raw: внутри лежат Jinja-шаблоны Home Assistant (value_json в двойных
    # скобках). Без этого флага чарт прогонит их через tpl и упадёт на
    # "function not defined".
    raw: true
    data:
      # HA пишет в /config свои файлы (.storage, automations.yaml, БД),
      # поэтому из ConfigMap монтируется только configuration.yaml через
      # subPath — остальное живёт в PVC и переживает пересоздание пода.
      #
      # Сам конфиг лежит отдельным файлом: так он остаётся валидным YAML,
      # который читают линтеры и подсветка редактора, и в нём не нужно
      # экранировать Jinja HA от рендера helmfile.
      configuration.yaml: |
{{ readFile "files/configuration.yaml" | indent 8 }}

persistence:
  data:
    enabled: true
    size: 5Gi
    storageClassName: local-path

# configuration.yaml ссылается на automations/scripts/scenes через !include,
# а HA падает при старте, если файла нет. На свежем PVC их ещё нет,
# поэтому создаём пустые перед стартом (существующие не трогаем).
initContainers:
  - name: init-config
    image: "ghcr.io/home-assistant/home-assistant:stable"
    command: ["/bin/sh", "-c"]
    args:
      - |
        set -eu
        # Пустой файл HA читает как "нет записей" и для списка, и для словаря.
        for f in automations.yaml scripts.yaml scenes.yaml; do
          [ -e "/config/$f" ] || : > "/config/$f"
        done
    volumeMounts:
      - name: data
        mountPath: /config

  # Ставит/обновляет HACS (custom_components/hacs) при каждом старте пода.
  # Официальный скрипт идемпотентен — сам качает актуальный релиз и
  # перезаписывает только код HACS, пользовательские данные не трогает.
  # Первичную авторизацию (GitHub device flow) всё равно нужно пройти
  # руками в Settings -> Devices & Services -> Add Integration -> HACS.
  - name: init-hacs
    image: "ghcr.io/home-assistant/home-assistant:stable"
    command: ["/bin/sh", "-c"]
    args:
      - |
        set -eu
        wget -O - https://get.hacs.xyz | bash -
    volumeMounts:
      - name: data
        mountPath: /config

volumes:
  - name: config
    configMap:
      name: homeassistant-config
      defaultMode: 0644
  - name: data
    persistentVolumeClaim:
      claimName: homeassistant-data
  # Системная шина хоста — через неё HA видит BlueZ (Bluetooth-интеграции)
  # и прочие сервисы ноды. Как и hostNetwork выше, это осознанный выход за
  # пределы пода: до сокета в /var/run/dbus ноды из overlay-сети не достучаться.
  - name: dbus
    hostPath:
      path: /var/run/dbus

volumeMounts:
  - name: data
    mountPath: /config
  # readOnly относится к самой файловой системе; подключение к unix-сокету
  # это не блокирует, а случайную запись в /var/run/dbus ноды — да.
  - name: dbus
    mountPath: /var/run/dbus
    readOnly: true
  - name: config
    mountPath: /config/configuration.yaml
    subPath: configuration.yaml
